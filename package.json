{
	"name": "effect-playground",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun run --parallel dev:launcher dev:client",
		"dev:launcher": "bun scripts/cpp.ts && exec cpp/build/effect-playground-backend -- bun --watch src/server/main.ts",
		"dev:server": "bun --watch src/server/main.ts",
		"dev:client": "vite",
		"build": "vite build",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check --error-on-warnings .",
		"fix": "biome check --write .",
		"knip": "knip",
		"test": "bun test",
		"generate": "bun scripts/generate.ts",
		"generate:check": "bun scripts/generate.ts --check"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.7",
		"@effect/platform-node-shared": "4.0.7",
		"@hookform/resolvers": "^6.0.2",
		"effect": "4.0.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.91.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"bun-types": "1.4.2",
		"knip": "^6.29.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	}
}
