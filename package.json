{
	"name": "effect-playground",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun scripts/cpp.ts && exec cpp/build/core -- bun --watch src/server/main.ts",
		"build": "bun scripts/cpp.ts && bun build --compile --minify src/server/main.ts --outfile dist/bff",
		"start": "exec cpp/build/core -- dist/bff",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check --error-on-warnings .",
		"fix": "biome check --write .",
		"knip": "knip",
		"deps": "depcruise --config .dependency-cruiser.cjs src test scripts",
		"test": "bun test",
		"generate": "bun scripts/generate.ts",
		"generate:check": "bun scripts/generate.ts --check"
	},
	"dependencies": {
		"@effect/atom-react": "4.0.7",
		"@effect/platform-bun": "4.0.7",
		"@effect/platform-node-shared": "4.0.7",
		"@hookform/resolvers": "^6.0.2",
		"effect": "4.0.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.91.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@swc/core": "1.16.22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"bun-types": "1.4.2",
		"dependency-cruiser": "18.7.2",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	}
}
