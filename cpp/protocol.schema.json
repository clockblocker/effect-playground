{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "prefixItems": [
        {
            "$ref": "#/$defs/protocol__ReadFile"
        },
        {
            "$ref": "#/$defs/protocol__CustomCat"
        }
    ],
    "items": false,
    "$defs": {
        "protocol__CustomCat": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__CustomCatRequest"
                },
                "success": {
                    "$ref": "#/$defs/protocol__CustomCatSuccess"
                },
                "error": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__InvalidRequest__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "success",
                "error"
            ]
        },
        "protocol__CustomCatRequest": {
            "type": "object",
            "properties": {
                "inputFile": {
                    "description": "The file to copy, such as \"hello.txt\". Only its base name is used, so a request never leaves the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        }
                    ]
                },
                "outputFile": {
                    "description": "The file to write the copy to, replacing it if it exists. Only its base name is used, as for the input.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        }
                    ]
                }
            },
            "required": [
                "inputFile",
                "outputFile"
            ]
        },
        "protocol__CustomCatSuccess": {
            "type": "object",
            "properties": {
                "bytesCopied": {
                    "type": "integer",
                    "description": "How many bytes the output file holds."
                }
            },
            "required": [
                "bytesCopied"
            ]
        },
        "protocol__InvalidRequest__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "InvalidRequest"
                    ]
                },
                "issues": {
                    "type": "array",
                    "description": "Every problem with the request's fields, one per failed rule.",
                    "items": {
                        "$ref": "#/$defs/protocol__Issue"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "_tag",
                "issues"
            ]
        },
        "protocol__Issue": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "description": "What is wrong.",
                    "enum": [
                        "Missing",
                        "TooShort",
                        "TooLong",
                        "NotTxtFile",
                        "FileNotFound"
                    ]
                },
                "message": {
                    "type": "string",
                    "description": "What is wrong, in a sentence."
                },
                "path": {
                    "type": "array",
                    "description": "Where the field is in the request, such as [\"files\", 2, \"input\"].",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer"
                            }
                        ]
                    }
                }
            },
            "required": [
                "code",
                "message",
                "path"
            ]
        },
        "protocol__ReadFile": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__ReadFileRequest"
                },
                "success": {
                    "$ref": "#/$defs/protocol__ReadFileSuccess"
                },
                "error": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__InvalidRequest__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "success",
                "error"
            ]
        },
        "protocol__ReadFileRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "description": "The file to read, such as \"hello.txt\". Only its base name is used, so a request never leaves the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        }
                    ]
                }
            },
            "required": [
                "name"
            ]
        },
        "protocol__ReadFileSuccess": {
            "type": "object",
            "properties": {
                "contents": {
                    "type": "string",
                    "description": "The whole file, decoded as UTF-8."
                }
            },
            "required": [
                "contents"
            ]
        }
    },
    "x-issues": {
        "Missing": {
            "message": "Required"
        },
        "TooShort": {
            "message": "Must be at least {limit} characters long",
            "keyword": "minLength"
        },
        "TooLong": {
            "message": "Must be at most {limit} characters long",
            "keyword": "maxLength"
        },
        "NotTxtFile": {
            "message": "\"{value}\" is not a .txt file"
        },
        "FileNotFound": {
            "message": "\"{value}\" does not exist"
        }
    }
}
