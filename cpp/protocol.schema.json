{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "prefixItems": [
        {
            "$ref": "#/$defs/protocol__CustomCat"
        }
    ],
    "items": false,
    "$defs": {
        "protocol__CustomCat": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__CustomCatRequest"
                },
                "success": {
                    "$ref": "#/$defs/protocol__CustomCatSuccess"
                },
                "error": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__InvalidRequest__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__IoFailed__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "success",
                "error"
            ]
        },
        "protocol__CustomCatRequest": {
            "type": "object",
            "properties": {
                "inputFile": {
                    "description": "The file to copy, such as \"hello.txt\", in the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        },
                        {
                            "type": "string",
                            "pattern": "^(?!\\.\\.?$)[^/\\\\]*$"
                        },
                        {
                            "type": "string",
                            "pattern": "^.+\\.txt$"
                        }
                    ]
                },
                "outputFile": {
                    "description": "The file to write the copy to, in the files directory, replacing it if it exists.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        },
                        {
                            "type": "string",
                            "pattern": "^(?!\\.\\.?$)[^/\\\\]*$"
                        },
                        {
                            "type": "string",
                            "pattern": "^.+\\.txt$"
                        }
                    ]
                }
            },
            "required": [
                "inputFile",
                "outputFile"
            ]
        },
        "protocol__CustomCatSuccess": {
            "type": "object",
            "properties": {
                "bytesCopied": {
                    "type": "integer",
                    "description": "How many bytes the output file holds."
                }
            },
            "required": [
                "bytesCopied"
            ]
        },
        "protocol__InvalidRequest__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "InvalidRequest"
                    ]
                },
                "issues": {
                    "type": "array",
                    "description": "Every problem with the request's fields, one per failed rule.",
                    "items": {
                        "$ref": "#/$defs/protocol__Issue"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "_tag",
                "issues"
            ]
        },
        "protocol__IoFailed__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "IoFailed"
                    ]
                },
                "operation": {
                    "type": "string",
                    "description": "What was being done to the file.",
                    "enum": [
                        "read",
                        "write"
                    ]
                },
                "file": {
                    "type": "string",
                    "description": "The file, as the request names it."
                },
                "reason": {
                    "type": "string",
                    "description": "What the system said, such as \"Is a directory\"."
                }
            },
            "required": [
                "_tag",
                "operation",
                "file",
                "reason"
            ]
        },
        "protocol__Issue": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "description": "What is wrong, in a sentence."
                },
                "path": {
                    "type": "array",
                    "description": "Where in the request the problem is: a field, such as [\"files\", 2, \"input\"], or [] for the request as a whole.",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer"
                            }
                        ]
                    }
                }
            },
            "required": [
                "message",
                "path"
            ]
        }
    },
    "x-errors": {
        "IoFailed": {
            "message": "Couldn't {operation} \"{file}\": {reason}"
        }
    }
}
