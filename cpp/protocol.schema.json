{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "prefixItems": [
        {
            "$ref": "#/$defs/protocol__ReadFile"
        },
        {
            "$ref": "#/$defs/protocol__CustomCat"
        }
    ],
    "items": false,
    "$defs": {
        "protocol__CustomCat": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__CustomCatRequest"
                },
                "success": {
                    "$ref": "#/$defs/protocol__CustomCatSuccess"
                },
                "error": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__NotTxtFile__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__FileNotFound__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "success",
                "error"
            ]
        },
        "protocol__CustomCatRequest": {
            "type": "object",
            "properties": {
                "inputFile": {
                    "description": "The file to copy, such as \"hello.txt\". Only its base name is used, so a request never leaves the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        }
                    ]
                },
                "outputFile": {
                    "description": "The file to write the copy to, replacing it if it exists. Only its base name is used, as for the input.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        }
                    ]
                }
            },
            "required": [
                "inputFile",
                "outputFile"
            ]
        },
        "protocol__CustomCatSuccess": {
            "type": "object",
            "properties": {
                "bytesCopied": {
                    "type": "integer",
                    "description": "How many bytes the output file holds."
                }
            },
            "required": [
                "bytesCopied"
            ]
        },
        "protocol__FileNotFound__tagged": {
            "type": "object",
            "x-message": "\"{file}\" does not exist",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "FileNotFound"
                    ]
                },
                "file": {
                    "type": "string",
                    "description": "The requested name; no such .txt file exists."
                }
            },
            "required": [
                "_tag",
                "file"
            ]
        },
        "protocol__NotTxtFile__tagged": {
            "type": "object",
            "x-message": "\"{file}\" is not a .txt file",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "NotTxtFile"
                    ]
                },
                "file": {
                    "type": "string",
                    "description": "The requested name, which does not end in .txt."
                }
            },
            "required": [
                "_tag",
                "file"
            ]
        },
        "protocol__ReadFile": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__ReadFileRequest"
                },
                "success": {
                    "$ref": "#/$defs/protocol__ReadFileSuccess"
                },
                "error": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__NotTxtFile__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__FileNotFound__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "success",
                "error"
            ]
        },
        "protocol__ReadFileRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "description": "The file to read, such as \"hello.txt\". Only its base name is used, so a request never leaves the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        }
                    ]
                }
            },
            "required": [
                "name"
            ]
        },
        "protocol__ReadFileSuccess": {
            "type": "object",
            "properties": {
                "contents": {
                    "type": "string",
                    "description": "The whole file, decoded as UTF-8."
                }
            },
            "required": [
                "contents"
            ]
        }
    }
}
