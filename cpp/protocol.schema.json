{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "prefixItems": [
        {
            "$ref": "#/$defs/protocol__CustomCat"
        },
        {
            "$ref": "#/$defs/protocol__CustomWc"
        }
    ],
    "items": false,
    "$defs": {
        "protocol__CustomCat": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__CustomCatRequest"
                },
                "output": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__CustomCatSuccess__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__InvalidRequest__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__IoFailed__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "output"
            ]
        },
        "protocol__CustomCatRequest": {
            "type": "object",
            "properties": {
                "inputFile": {
                    "description": "The file to copy, such as \"hello.txt\", in the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        },
                        {
                            "type": "string",
                            "pattern": "^(?!\\.\\.?$)[^/\\\\]*$"
                        },
                        {
                            "type": "string",
                            "pattern": "^.+\\.txt$"
                        }
                    ]
                },
                "outputFile": {
                    "description": "The file to write the copy to, in the files directory, replacing it if it exists.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        },
                        {
                            "type": "string",
                            "pattern": "^(?!\\.\\.?$)[^/\\\\]*$"
                        },
                        {
                            "type": "string",
                            "pattern": "^.+\\.txt$"
                        }
                    ]
                }
            },
            "required": [
                "inputFile",
                "outputFile"
            ]
        },
        "protocol__CustomCatSuccess__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "Success"
                    ]
                },
                "bytesCopied": {
                    "type": "integer",
                    "description": "How many bytes the output file holds."
                }
            },
            "required": [
                "_tag",
                "bytesCopied"
            ]
        },
        "protocol__CustomWc": {
            "type": "object",
            "properties": {
                "payload": {
                    "$ref": "#/$defs/protocol__CustomWcRequest"
                },
                "output": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/protocol__CustomWcSuccess__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__InvalidRequest__tagged"
                        },
                        {
                            "$ref": "#/$defs/protocol__IoFailed__tagged"
                        }
                    ]
                }
            },
            "required": [
                "payload",
                "output"
            ]
        },
        "protocol__CustomWcRequest": {
            "type": "object",
            "properties": {
                "file": {
                    "description": "The file to count, such as \"hello.txt\", in the files directory.",
                    "allOf": [
                        {
                            "type": "string",
                            "minLength": 5
                        },
                        {
                            "type": "string",
                            "maxLength": 25
                        },
                        {
                            "type": "string",
                            "pattern": "^(?!\\.\\.?$)[^/\\\\]*$"
                        },
                        {
                            "type": "string",
                            "pattern": "^.+\\.txt$"
                        }
                    ]
                }
            },
            "required": [
                "file"
            ]
        },
        "protocol__CustomWcSuccess__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "Success"
                    ]
                },
                "lines": {
                    "type": "integer",
                    "description": "How many newlines the file holds."
                },
                "words": {
                    "type": "integer",
                    "description": "How many runs of non-space characters it holds."
                },
                "bytes": {
                    "type": "integer",
                    "description": "How many bytes it holds."
                }
            },
            "required": [
                "_tag",
                "lines",
                "words",
                "bytes"
            ]
        },
        "protocol__InvalidRequest__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "InvalidRequest"
                    ]
                },
                "issues": {
                    "type": "array",
                    "description": "Every problem with the request's fields, one per failed rule.",
                    "items": {
                        "$ref": "#/$defs/protocol__Issue"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "_tag",
                "issues"
            ]
        },
        "protocol__IoFailed__tagged": {
            "type": "object",
            "properties": {
                "_tag": {
                    "type": "string",
                    "enum": [
                        "IoFailed"
                    ]
                },
                "message": {
                    "type": "string",
                    "description": "What the system said, such as \"Is a directory\"."
                }
            },
            "required": [
                "_tag",
                "message"
            ]
        },
        "protocol__Issue": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "description": "What is wrong, in a sentence."
                },
                "path": {
                    "type": "array",
                    "description": "Where in the request the problem is: a field, such as [\"files\", 2, \"input\"], or [] for the request as a whole.",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer"
                            }
                        ]
                    }
                }
            },
            "required": [
                "message",
                "path"
            ]
        }
    }
}
